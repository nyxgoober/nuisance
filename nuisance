#!/usr/bin/env python3
import argparse
import os
import re
import subprocess
import sys


# ══════════════════════════════════════════
# FILE TYPE DETECTION
# ══════════════════════════════════════════

_LRC_TS_LINE_RE = re.compile(r"^\s*\[\d+:\d+(?:[.:]\d+){0,2}\]")
_LRC_META_RE    = re.compile(r"^\s*\[(?:ti|ar|al|au|length|by|offset|re|ve):", re.IGNORECASE)
_ELRC_WORD_RE   = re.compile(r"<\d+:\d+(?:[.:]\d+){0,2}>")


def _read_bytes(path, n):
    try:
        with open(path, "rb") as f:
            return f.read(n)
    except OSError:
        return b""


def _read_text(path, n=8192):
    raw = _read_bytes(path, n)
    if not raw:
        return ""
    if raw.startswith((b"\xff\xfe", b"\xfe\xff")):
        return raw.decode("utf-16", errors="replace")
    for enc in ("utf-8-sig", "cp932", "gb18030"):
        try:
            return raw.decode(enc)
        except UnicodeDecodeError:
            continue
    return raw.decode("utf-8", errors="replace")


def _is_mpeg_or_adts(header):
    """Validate MPEG audio or ADTS AAC sync header while excluding UTF-16 BOMs."""
    if len(header) < 4:
        return False
    if header[:2] in (b"\xff\xfe", b"\xfe\xff"):
        # Check if odd/even bytes look like UTF-16 ASCII text (null bytes)
        if header[2] == 0x00 or header[3] == 0x00:
            return False
    if header[0] != 0xFF or (header[1] & 0xE0) != 0xE0:
        return False
    # ADTS AAC: syncword 0xFFF, layer == 00
    if (header[1] & 0xF6) == 0xF0:
        return True
    # MPEG Layer I/II/III: version != 01 (reserved), layer != 00, bitrate != 1111/0000, sr != 11
    version_bits = (header[1] >> 3) & 0x03
    layer_bits   = (header[1] >> 1) & 0x03
    bitrate_bits = (header[2] >> 4) & 0x0F
    sr_bits      = (header[2] >> 2) & 0x03
    return (
        version_bits != 0x01
        and layer_bits != 0x00
        and bitrate_bits not in (0x00, 0x0F)
        and sr_bits != 0x03
    )


def detect_type(path):
    header = _read_bytes(path, 16)
    if not header:
        return "unknown"

    if header[:4] == b"MThd":
        return "midi"

    if len(header) >= 12 and header[:4] in (b"RIFF", b"RF64") and header[8:12] == b"WAVE":
        return "audio"
    if header[:4] == b"fLaC":
        return "audio"
    if header[:4] == b"OggS":
        return "audio"
    if len(header) >= 12 and header[:4] == b"FORM" and header[8:12] in (b"AIFF", b"AIFC"):
        return "audio"
    if header[:3] == b"ID3":
        return "audio"
    if len(header) >= 8 and header[4:8] in (b"ftyp", b"moov"):
        return "audio"
    if _is_mpeg_or_adts(header):
        return "audio"

    text = _read_text(path, 8192)
    text_clean = text.lstrip("\ufeff").lstrip()
    text_lower = text_clean.lower()

    if text_lower.startswith("<?xml") or text_lower.startswith("<tt"):
        if any(
            tok in text_lower
            for tok in ("http://www.w3.org/ns/ttml", "<tt ", "<tt\n", "<tt\r", "<tt\t", "<tt>")
        ):
            return "ttml"

    if any(tok in text_lower for tok in ("<tt ", "<tt>", "http://www.w3.org/ns/ttml")):
        return "ttml"

    lines = text_clean.splitlines()[:50]
    ts_hits   = sum(1 for ln in lines if _LRC_TS_LINE_RE.match(ln))
    meta_hits = sum(1 for ln in lines if _LRC_META_RE.match(ln))
    if ts_hits >= 1 or meta_hits >= 2:
        if _ELRC_WORD_RE.search(text_clean):
            return "elrc"
        return "lrc"

    return "unknown"


def _ext_fallback(path):
    ext = os.path.splitext(path)[1].lower()
    if ext in (".mid", ".midi"):
        return "midi"
    if ext in (".ttml", ".xml"):
        return "ttml"
    if ext in (".elrc",):
        return "elrc"
    if ext in (".lrc",):
        return "lrc"
    if ext in (".wav", ".flac", ".ogg", ".mp3", ".aiff", ".aif", ".m4a", ".aac", ".opus"):
        return "audio"
    return "unknown"


def identify(path):
    kind = detect_type(path)
    if kind == "unknown":
        kind = _ext_fallback(path)
    return kind


# ══════════════════════════════════════════
# INTERACTIVE WIZARD
# ══════════════════════════════════════════

def _prompt(label, default=None, required=True):
    """Print a prompt and return stripped input. Returns default on empty."""
    hint = f"  [{default}]" if default is not None and default != "" else ""
    while True:
        try:
            val = input(f"  {label}{hint}: ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            sys.exit(0)
        if val:
            return val
        if default is not None:
            return str(default)
        if not required:
            return ""
        print("    (required)")


def _prompt_float(label, default="", required=False, positive=True):
    while True:
        raw = _prompt(label, default=default, required=required)
        if raw == "":
            return ""
        try:
            v = float(raw)
            if positive and v <= 0:
                print("    (must be > 0)")
                continue
            return raw
        except ValueError:
            print("    (enter a valid number)")


def _prompt_int(label, default=None, minimum=1):
    while True:
        raw = _prompt(label, default=default)
        try:
            v = int(raw)
            if v < minimum:
                print(f"    (must be >= {minimum})")
                continue
            return str(v)
        except ValueError:
            print("    (enter an integer)")


def _prompt_choice(label, choices, default=None):
    """Prompt with numbered choices. Returns the chosen string."""
    print(f"  {label}")
    for i, c in enumerate(choices, 1):
        marker = " *" if c == default else ""
        print(f"    {i}) {c}{marker}")
    while True:
        raw = _prompt("choice", default=default)
        if raw.isdigit():
            idx = int(raw) - 1
            if 0 <= idx < len(choices):
                return choices[idx]
        if raw in choices:
            return raw
        print(f"    enter a number 1–{len(choices)}")


def _prompt_bool(label, default=False):
    hint = "Y/n" if default else "y/N"
    raw = _prompt(f"{label} ({hint})", default="", required=False).lower()
    if not raw:
        return default
    return raw.startswith("y")


def wizard():
    """Interactive setup — returns (input_path, kind, forward_args list)."""
    print()
    print("  ╔══════════════════════════════╗")
    print("  ║       Nuisance Wizard        ║")
    print("  ╚══════════════════════════════╝")
    print()

    # ── input file ───────────────────────────────────────────────────────
    while True:
        path = _prompt("input file")
        if os.path.isfile(path):
            break
        print(f"    file not found: {path}")

    kind = identify(path)
    KIND_LABEL = {
        "ttml":  "TTML lyrics",
        "lrc":   "LRC lyrics",
        "elrc":  "Enhanced LRC lyrics",
        "midi":  "MIDI file",
        "audio": "audio file",
    }
    print(f"    detected: {KIND_LABEL.get(kind, kind)}")
    print()

    if kind == "unknown":
        print(
            f"  Could not identify '{path}' from content or extension.\n"
            "  Supported: TTML (.ttml/.xml), LRC / Enhanced LRC (.lrc), "
            "MIDI (.mid/.midi), audio (wav/flac/ogg/mp3/aiff/m4a/aac/opus)."
        )
        sys.exit(1)

    forward = ["--input", path]

    # ── type-specific questions ───────────────────────────────────────────
    if kind in ("ttml", "lrc", "elrc"):
        dur = _prompt_float("duration (seconds, blank = auto-detect)", default="", required=False)
        if dur:
            forward += ["--duration", dur]

        title = _prompt("title override (blank = from file)", default="", required=False)
        if title:
            forward += ["--title", title]

        while True:
            romanise = _prompt(
                "romanisation TTML/LRC (leave blank to skip)", default="", required=False
            )
            if not romanise or os.path.isfile(romanise):
                break
            print(f"    file not found: {romanise}")
        if romanise:
            forward += ["--romanise", romanise]

    elif kind == "midi":
        dur = _prompt_float("duration (seconds, blank = auto-detect)", default="", required=False)
        if dur:
            forward += ["--duration", dur]

        title = _prompt("title override (blank = filename)", default="", required=False)
        if title:
            forward += ["--title", title]

        lookahead = _prompt_float(
            "lookahead seconds (notes visible above keyboard)", default="3.0", required=True
        )
        if lookahead != "3.0":
            forward += ["--lookahead", lookahead]

    elif kind == "audio":
        mode = _prompt_choice("visualiser mode", ["waveform", "spectrum"], default="waveform")
        forward += ["--mode", mode]

        if mode == "spectrum":
            bars = _prompt_int("number of frequency bars", default="64", minimum=1)
            if bars != "64":
                forward += ["--bars", bars]

        dur = _prompt_float("duration (seconds, blank = auto-detect)", default="", required=False)
        if dur:
            forward += ["--duration", dur]

        title = _prompt("title override (blank = filename)", default="", required=False)
        if title:
            forward += ["--title", title]

    # ── shared output options ─────────────────────────────────────────────
    print()
    output_mode = _prompt_choice(
        "output mode",
        ["opaque", "transparent (RGBA)", "green screen"],
        default="opaque",
    )
    if "transparent" in output_mode:
        forward.append("--transparent")
    elif "green" in output_mode:
        forward.append("--greenscreen")

    preview = _prompt_bool("preview only (1 frame/sec, skips confirmation)", default=False)
    if preview:
        forward.append("--preview")

    default_workers = str(os.cpu_count() or 1)
    workers = _prompt_int("worker threads", default=default_workers, minimum=1)
    if workers != default_workers:
        forward += ["--workers", workers]

    print()
    return path, kind, forward


# ══════════════════════════════════════════
# DISPATCH
# ══════════════════════════════════════════

def _script_path(name):
    here = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(here, name)


def dispatch(kind, raw_args):
    scripts = {
        "ttml":  "lyrics.py",
        "lrc":   "lyrics.py",
        "elrc":  "lyrics.py",
        "midi":  "midimap.py",
        "audio": "waveform.py",
    }
    if kind not in scripts:
        return None
    script = _script_path(scripts[kind])
    if not os.path.exists(script):
        print(f"  error: renderer not found: {script}", file=sys.stderr)
        sys.exit(1)
    return [sys.executable, script] + raw_args


# ══════════════════════════════════════════
# MAIN
# ══════════════════════════════════════════

def main():
    no_flags = len(sys.argv) == 1

    if no_flags:
        _, kind, forward = wizard()
    else:
        parser = argparse.ArgumentParser(
            prog="nuisance",
            description="Nuisance — central dispatcher for the music renderer suite.\n"
                        "Run without flags for interactive setup wizard.",
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="""
renderers:
  lyrics.py     TTML / LRC / Enhanced LRC → lyric video (syllable wipe, kinetic scroll)
  midimap.py    MIDI files                → Synthesia-style falling-note visualiser
  waveform.py   Audio files               → scrolling waveform or frequency spectrum bars

detection order:
  1. File content (magic bytes / XML structure / LRC heuristics)
  2. File extension fallback

examples:
  python nuisance --input lyrics.ttml --duration 217
  python nuisance --input lyrics.lrc  --preview
  python nuisance --input song.mid    --transparent
  python nuisance --input audio.wav   --mode spectrum --bars 80 --preview
  python nuisance --input audio.mp3   --greenscreen --title "My Track"

all flags after --input are forwarded to the detected renderer.
run a renderer directly with --help for its full flag reference:
  python lyrics.py    --help
  python midimap.py   --help
  python waveform.py  --help
            """
        )
        parser.add_argument(
            "--input", "-i", required=True,
            help="Input file (TTML, LRC, Enhanced LRC, MIDI, or audio). Type is auto-detected."
        )
        args, remainder = parser.parse_known_args()

        if not os.path.isfile(args.input):
            print(f"  error: file not found: {args.input}", file=sys.stderr)
            sys.exit(1)

        kind = identify(args.input)

        KIND_LABEL = {
            "ttml":    "TTML lyrics   → lyrics.py",
            "lrc":     "LRC lyrics    → lyrics.py",
            "elrc":    "Enhanced LRC  → lyrics.py",
            "midi":    "MIDI file     → midimap.py",
            "audio":   "audio file    → waveform.py",
            "unknown": "unknown type",
        }
        print(f"\n  detected: {KIND_LABEL.get(kind, kind)}")

        if kind == "unknown":
            print(
                f"  Could not identify '{args.input}' from content or extension.\n"
                "  Supported types: TTML (.ttml/.xml), LRC / Enhanced LRC (.lrc), "
                "MIDI (.mid/.midi), audio (wav/flac/ogg/mp3/aiff/m4a/aac/opus).",
                file=sys.stderr,
            )
            sys.exit(1)

        forward = ["--input", args.input] + remainder

    cmd = dispatch(kind, forward)
    display = " ".join(f'"{a}"' if " " in a else a for a in cmd)
    print(f"  → {display}\n")
    sys.exit(subprocess.run(cmd).returncode)


if __name__ == "__main__":
    main()
